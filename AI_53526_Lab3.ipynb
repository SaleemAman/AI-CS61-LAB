      "source": [
        "import numpy as np\n",
        "\n",
        "arr = np.arange(2, 11)\n",
        "matrix = arr.reshape(3,3)\n",
        "matrix = matrix.astype(float)\n",
        "\n",
        "flat = matrix.reshape(-1)\n",
        "\n",
        "print(\"Matrix:\\n\", matrix)\n",
        "print(\"Flattened:\", flat)\n",
        "print(\"Maximum:\", np.max(flat))\n",
        "print(\"Minimum:\", np.min(flat))"
      ]
    }
  ]
